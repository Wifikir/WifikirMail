# Database
DATABASE_URL=postgres://wifikirmail:password@localhost/wifikir_mail

# SMTP (Postfix localhost)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_FROM=noreply@wifikir.com
# Optional. When set, envelope sender is bounce+<job_id>@BOUNCE_DOMAIN
BOUNCE_DOMAIN=
# Maildir with new/ and cur/. Empty disables the async bounce reader.
BOUNCE_MAILDIR=
BOUNCE_POLL_SECS=30

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Worker
WORKER_INTERVAL_SECS=10
MAX_ATTEMPTS=3
JOB_LEASE_DURATION_SECS=300

# Tracker
TRACKER_POLL_INTERVAL_SECS=30

# Rate Limiting
# Per-key limit (requests per minute per API key)
RATE_LIMIT_PER_MINUTE=60
# Global limit (requests per minute across all keys)
RATE_LIMIT_GLOBAL=1000
# Queue capacity limit (max pending+processing jobs before rejecting with 503)
QUEUE_CAPACITY_LIMIT=10000

# Templates (version-controlled files)
TEMPLATE_DIR=templates

# Metrics listener (bind localhost; do not expose)
METRICS_HOST=127.0.0.1
METRICS_PORT=9090

# Postfix log the tracker reads, and cursor file
MAIL_LOG_PATH=/var/log/mail.log
CURSOR_PATH=/var/lib/wifikir-mail/mail.log.cursor

# Logging
RUST_LOG=wifikir_mail=info,tower_http=debug

# Integration tests (optional; set to your Postgres)
# TEST_DATABASE_URL=postgres://wifikirmail:password@localhost/wifikir_mail_test
