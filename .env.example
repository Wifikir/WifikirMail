# Database
DATABASE_URL=postgres://wifikirmail:password@localhost/wifikir_mail

# SMTP (Postfix localhost)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_FROM=noreply@wifikir.com

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Worker
WORKER_INTERVAL_SECS=10
MAX_ATTEMPTS=3
JOB_LEASE_DURATION_SECS=300

# Tracker
TRACKER_POLL_INTERVAL_SECS=30

# Rate Limiting
# Per-key limit (requests per minute per API key)
RATE_LIMIT_PER_MINUTE=60
# Global limit (requests per minute across all keys)
RATE_LIMIT_GLOBAL=1000
# Queue capacity limit (max pending+processing jobs before rejecting with 503)
QUEUE_CAPACITY_LIMIT=10000

# Logging
RUST_LOG=wifikir_mail=info,tower_http=debug
